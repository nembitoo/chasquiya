# ---------------------------------------------------------------------------
# Chasquiya — plantilla de variables de entorno (SIN secretos reales)
#
# Cómo usar:
#   1. Copia este archivo a ".env"  ->  cp .env.example .env   (o copiar/pegar)
#   2. Cambia los valores marcados con "cambia_esto" por otros propios.
#   3. El .env real NUNCA se sube a Git (ya está en .gitignore).
# ---------------------------------------------------------------------------

# --- Base de datos: PostgreSQL + PostGIS ---
POSTGRES_DB=chasquiya
POSTGRES_USER=chasquiya
POSTGRES_PASSWORD=cambia_esto
POSTGRES_PORT=5432

# --- Almacenamiento de fotos: MinIO ("S3 local") ---
# Se usará de verdad desde el Hito 2 (documentos/fotos), pero lo dejamos listo.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=cambia_esto
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Correos de prueba: Mailpit (sucesor mantenido de Mailhog) ---
# Se usará desde hitos posteriores; captura los correos localmente.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Backend Spring Boot ---
BACKEND_PORT=8080

# --- Autenticación JWT ---
# Secreto para firmar los tokens. Mínimo 32 caracteres. Genera uno propio.
# En desarrollo, si no lo defines, el backend usa un valor por defecto (ver application.properties).
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria_min_32_chars
JWT_EXP_HORAS=12
