# ---------------------------------------------------------------------------
# Chasquiya — qué NO se sube al repositorio
# Regla de oro: nada de secretos, nada de artefactos generados.
# ---------------------------------------------------------------------------

# Variables de entorno reales (SÍ se sube .env.example, NUNCA el .env)
.env
.env.local
*.env

# --- Backend / Java / Maven ---
backend/target/
*.class
*.jar
*.war
!**/mvnw.jar
.mvn/wrapper/maven-wrapper.jar

# --- App / Node / Expo ---
node_modules/
app/.expo/
app/dist/
app/web-build/
npm-debug.*
yarn-error.*

# --- Claude Code (configuración personal, por máquina) ---
.claude/settings.local.json

# --- Editores / IDE ---
.idea/
*.iml
.vscode/
*.swp

# --- Sistema operativo ---
.DS_Store
Thumbs.db

# --- Logs ---
*.log
